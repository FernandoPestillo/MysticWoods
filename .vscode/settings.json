{
    // Hide only generated or binary noise; art, audio, prefabs, scenes and materials stay visible.
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.vs": true,
        "**/.gitmodules": true,
        "**/.vsconfig": true,
        "**/*.booproj": true,
        "**/*.pidb": true,
        "**/*.suo": true,
        "**/*.user": true,
        "**/*.userprefs": true,
        "**/*.unityproj": true,
        "**/*.dll": true,
        "**/*.exe": true,
        "**/*.meta": true,
        "build/": true,
        "Build/": true,
        "Library/": true,
        "library/": true,
        "obj/": true,
        "Obj/": true,
        "Logs/": true,
        "logs/": true,
        "UserSettings/": true,
        "temp/": true,
        "Temp/": true
    },
    // Keep large generated folders out of search and the file watcher.
    "search.exclude": {
        "Library/": true,
        "Temp/": true,
        "Logs/": true,
        "Builds/": true,
        "**/*.meta": true
    },
    "files.watcherExclude": {
        "**/Library/**": true,
        "**/Temp/**": true,
        "**/Logs/**": true
    },
    // Unity serialises these as YAML; open them with syntax highlighting.
    "files.associations": {
        "*.unity": "yaml",
        "*.prefab": "yaml",
        "*.asset": "yaml",
        "*.mat": "yaml",
        "*.anim": "yaml",
        "*.controller": "yaml",
        "*.overrideController": "yaml",
        "*.physicsMaterial2D": "yaml",
        "*.spriteatlas": "yaml",
        "*.spriteatlasv2": "yaml",
        "*.inputactions": "json",
        "*.asmdef": "json",
        "*.uss": "css",
        "*.uxml": "xml"
    },
    "dotnet.defaultSolution": "MysticWoods.slnx"
}
